#!/usr/bin/env bash
# Reject pushes that still contain agent co-author trailers.
set -euo pipefail

remote="${1:-}"
url="${2:-}"

z40=0000000000000000000000000000000000000000
agent_re='(Co-authored-by|Signed-off-by):.*(cursor|cursoragent|copilot|chatgpt|openai|claude|anthropic|gemini|noreply@cursor)|[Mm]ade with Cursor|[Gg]enerated with'

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_sha" = "$z40" ]]; then
    continue
  fi
  if [[ "$remote_sha" = "$z40" ]]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  if git rev-list "$range" >/dev/null 2>&1; then
    if git log --format='%B' "$range" | grep -Eiq "$agent_re"; then
      echo "pre-push: blocked — commit message still attributes an agent/AI tool." >&2
      echo "Remove Co-authored-by / Made with Cursor lines, then push again." >&2
      exit 1
    fi
  fi
done

exit 0
