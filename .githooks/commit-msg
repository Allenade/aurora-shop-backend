#!/usr/bin/env bash
# Strip AI/agent co-author trailers so they never appear on GitHub.
set -euo pipefail

msg_file="${1:-}"
if [[ -z "$msg_file" || ! -f "$msg_file" ]]; then
  exit 0
fi

tmp="$(mktemp)"
# Remove Co-authored-by / Signed-off-by lines that name known agent identities.
grep -Eiv \
  '^[[:space:]]*(Co-authored-by|Signed-off-by):.*(cursor|cursoragent|copilot|chatgpt|openai|claude|anthropic|gemini|agent|bot@|noreply@cursor)' \
  "$msg_file" >"$tmp" || true

# Also drop bare "Generated with ..." / "Made with Cursor" footers.
grep -Eiv \
  '^[[:space:]]*(generated with|made with|co-authored by).*(cursor|copilot|chatgpt|claude|agent)' \
  "$tmp" >"$msg_file" || true

rm -f "$tmp"
exit 0
