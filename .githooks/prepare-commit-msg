#!/usr/bin/env bash
# Runs before the editor opens / message is finalized. Strip agent trailers early.
set -euo pipefail

msg_file="${1:-}"
if [[ -z "$msg_file" || ! -f "$msg_file" ]]; then
  exit 0
fi

tmp="$(mktemp)"
grep -Eiv \
  '^[[:space:]]*(Co-authored-by|Signed-off-by):.*(cursor|cursoragent|copilot|chatgpt|openai|claude|anthropic|gemini|agent|bot@|noreply@cursor)' \
  "$msg_file" >"$tmp" || true
grep -Eiv \
  '^[[:space:]]*(generated with|made with|co-authored by).*(cursor|copilot|chatgpt|claude|agent)' \
  "$tmp" >"$msg_file" || true
rm -f "$tmp"
exit 0
