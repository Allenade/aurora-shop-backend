PORT=4000
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
WEBSITE_URL=http://localhost:3000
# Absolute API origin used in email links (unsubscribe). Defaults to http://localhost:$PORT.
PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgres://aurora:aurora@localhost:5432/aurora_shop
# TypeORM synchronize. Default false. Honoured only when NODE_ENV=development
# AND DATABASE_URL is localhost, 127.0.0.1, ::1, or the docker host "postgres".
# Staging and production must leave this unset or false. Schema changes run
# from migrations (migrationsRun), which alter columns in place.
DB_SYNCHRONIZE=false
REDIS_URL=redis://localhost:6379

JWT_SECRET_KEY=aurora-dev-jwt-secret-change-me
JWT_SALT_ROUNDS=10

DOCS_USERNAME=docs
DOCS_PASSWORD=replace-me

# Required in production. Empty in development enables Paystack mock mode
# (verifyReference returns success). Mock mode is refused in production.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYMENT_CREDENTIALS_ENC_KEY=dev-insecure-payments-encryption-key-change-me

# Honour X-Forwarded-For only from this many trusted proxy hops. false ignores the header.
TRUST_PROXY=false
# Set to false to disable public Enter First rate limits (default on).
RATE_LIMIT_ENABLED=true
ENTER_FIRST_PUBLIC_RATE_LIMIT=20

# Deprecated for checkout. Bank transfer is collected via Paystack Pay with Transfer.
BANK_NAME=Guaranty Trust Bank (GTB)
BANK_ACCOUNT_NAME=Aurora Stores Ltd
BANK_ACCOUNT_NUMBER=0123456789

RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@aurora.local
RESEND_FROM_NAME=Aurora Stores
# Svix signing secret from the Resend webhook (whsec_...). Required to accept webhooks in production.
RESEND_WEBHOOK_SECRET=
UNSUBSCRIBE_TOKEN_SECRET=
EMAIL_MAX_ATTEMPTS=5
EMAIL_BATCH_SIZE=100

SEED_ADMIN_EMAIL=admin@regaliaelectrical.ng
SEED_BUYER_EMAIL=bayonuga@example.com
SEED_PASSWORD=Aurora!2026

# Cloudflare R2 Storage
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aurorashop090
R2_PUBLIC_BASE_URL=https://pub-80fb763d2cac40069bedc39977ed512c.r2.dev
